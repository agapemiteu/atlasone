{
  "name": "atlas-one",
  "version": "0.1.0",
  "private": true,
  "description": "Connect the world to N-ATLaS: the MCP server and gateway to Nigeria's AI.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "wrangler dev",
    "build:web": "npm --prefix web run build",
    "deploy": "npm run build:web && wrangler deploy",
    "test": "vitest run && npm --prefix web test",
    "test:watch": "vitest",
    "typecheck": "wrangler types && tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply atlas-one --local",
    "db:migrate:remote": "wrangler d1 migrations apply atlas-one --remote",
    "seed": "node scripts/seed.ts",
    "smoke": "node --env-file=.env.local scripts/smoke.mjs",
    "invite": "node scripts/invite.mjs",
    "evidence:snapshot": "node scripts/evidence-snapshot.mjs",
    "evidence:verify": "node scripts/verify-evidence.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^22.20.5",
    "openai": "^7.32.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.3",
    "@modelcontextprotocol/server": "^2.0.0",
    "agents": "^0.28.0",
    "zod": "^4.6.5"
  }
}
