{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-one",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-one",
