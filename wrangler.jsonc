{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-one",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: required to fetch Client ID Metadata Documents safely (CIMD).
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Integration recipes are bundled as text.
  // Integration recipes and the model-server script (pushed to Kaggle on wake) are bundled as text.
  "rules": [{ "type": "Text", "globs": ["**/*.md", "**/*.py"], "fallthrough": true }],
  "observability": { "enabled": true },
  // Home page and docs: the React build in web/ (npm run build:web). Paths with no file fall through to
  // the Worker (/mcp, /v1, /api, OAuth, playground, ...).
  "assets": { "directory": "./web/dist", "html_handling": "auto-trailing-slash", "not_found_handling": "none" },
  "workers_dev": true,
  "preview_urls": false,
  // Hosts the Kaggle server may register (D3). Secrets ATLAS_UPSTREAM_KEY and ATLAS_ADMIN_KEY are set
  // with `wrangler secret put`, never here.
  // GITHUB_CLIENT_SECRET and SESSION_SECRET are secrets too.
  "vars": {
    "PUBLIC_ORIGIN": "https://atlas-one.collins-coordinator-worker.workers.dev",
    // Hosts a model server may register from: only the active provider's (Kaggle tunnels: "*.trycloudflare.com").
    "UPSTREAM_HOSTS": "*.modal.run",
    "GITHUB_CLIENT_ID": "Ov23liEjUtXPbExZAqVJ",
    // Who can sign in (D15, D21): "open" = any GitHub account; "invite" = only ALLOWED_GITHUB_LOGINS plus the
    // allowlist table (see docs/ARCHITECTURE.md). Open is safe: every project is quota-limited and usage is logged.
    "ACCESS": "open",
    "ALLOWED_GITHUB_LOGINS": "agapemiteu",
    // Atlas One team members: shown as "team" on /evidence and excluded from the external-tester summary.
    "TEAM_GITHUB_LOGINS": "agapemiteu",
    // Where N-ATLaS runs (D27): "modal" (inference/modal_serve.py, stable URL, 1-2 min cold start, paid credit) or
    // "kaggle" (inference/kaggle_serve.py, free, can queue for a GPU). Same runtime and weights on both.
    "COMPUTE": "modal",
    "MODAL_URL": "https://miteuagape--atlas-one-n-atlas-serve.modal.run",
    // Wake-on-demand (KAGGLE_KEY is a secret). The notebook must have the HF_TOKEN, ATLAS_UPSTREAM_KEY
    // and ATLAS_ADMIN_KEY Kaggle secrets attached.
    "KAGGLE_USERNAME": "agapemiteu",
    "KAGGLE_KERNEL": "notebookf585471141"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "3dda9cfc00b0490a817ca93ed39694ac" }],
  // Per-IP limit on sign-in and client-registration routes, so registration floods cannot exhaust KV.
  "ratelimits": [{ "name": "AUTH_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "atlas-one",
      "database_id": "130399d4-7b16-4f28-946f-e40f90e1f6e7",
      "migrations_dir": "migrations"
    }
  ]
}
